{
  "name": "elpis-desktop",
  "productName": "Elpis",
  "desktopName": "elpis-desktop.desktop",
  "main": "desktop/main.cts",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": "26.1.0"
  },
  "scripts": {
    "prebuild": "node bridge/build-resources.mts",
    "predev": "node bridge/build-resources.mts",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "git rev-parse HEAD > out/.commit && test ! -f $HOME/Desktop/p/skills/web-dev/ui-check/ui-check.mjs || node $HOME/Desktop/p/skills/web-dev/ui-check/ui-check.mjs .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "node scripts/strict-baseline.mts types tsx",
    "lint": "node ../../scripts/js-guard.mjs && node scripts/strict-baseline.mts lint",
    "duplication": "node scripts/strict-baseline.mts dup",
    "strict": "node scripts/strict-baseline.mts",
    "start": "node bridge/server.mts",
    "web": "node bridge/server.mts",
    "desktop": "desktop/launch.sh",
    "test:renderer": "node --test tests/renderer.test.cts",
    "test:drafts": "node --test tests/drafts.test.mts",
    "test:desktop": "node scripts/test-gate.mts desktop",
    "test:ui": "node scripts/test-gate.mts ui",
    "test:bridge": "node scripts/test-gate.mts bridge",
    "test": "node scripts/test-gate.mts",
    "test:inventory": "node scripts/test-gate.mts --check",
    "test:fast": "node scripts/test-gate.mts fast",
    "check:install": "node scripts/pre-install.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.16.47",
    "lucide-react": "1.37.0",
    "next": "16.2.6",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rrule": "2.8.1",
    "tailwind-merge": "3.6.0",
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.7.0",
    "expect": "30.2.0",
    "jest-mock": "30.2.0",
    "jscpd": "5.1.2",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.0",
    "typescript": "^5"
  }
}
