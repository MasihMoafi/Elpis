{
  "name": "elpis-desktop",
  "productName": "Elpis",
  "desktopName": "elpis-desktop.desktop",
  "main": "desktop/main.cjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node bridge/build-resources.mjs",
    "predev": "node bridge/build-resources.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "start": "node bridge/server.mjs",
    "web": "node bridge/server.mjs",
    "desktop": "desktop/launch.sh",
    "test:renderer": "node --test tests/renderer.test.cjs",
    "test:drafts": "node --test tests/drafts.test.mjs",
    "test:desktop": "node scripts/test-gate.mjs desktop",
    "test:ui": "node scripts/test-gate.mjs ui",
    "test:bridge": "node scripts/test-gate.mjs bridge",
    "test": "node scripts/test-gate.mjs",
    "test:inventory": "node scripts/test-gate.mjs --check",
    "test:fast": "node scripts/test-gate.mjs fast",
    "check:install": "node scripts/pre-install.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@base-ui/react": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "next": "16.2.6",
    "node-pty": "1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.7.0",
    "tailwindcss": "4.3.0",
    "typescript": "^5"
  }
}
