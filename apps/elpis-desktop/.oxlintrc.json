{
  // Modelled on DeepSeek Harness's .oxlintrc.json: its correctness and promise rules, for Elpis's JS and TSX.
  // Existing violations are a ratcheting baseline (scripts/strict-baseline.mts lint); new code must be clean.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": { "correctness": "off" },
  "options": { "reportUnusedDisableDirectives": "warn", "typeAware": true },
  "env": { "builtin": true, "node": true, "browser": true },
  "ignorePatterns": ["**/node_modules/**", "bridge/resources/**", ".next/**", "out/**", "public/**", "test-results/**", "next-env.d.ts"],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "no-useless-constructor": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "error",
    "no-self-assign": "error",
    "no-constant-condition": ["error", { "checkLoops": false }],
    "typescript/await-thenable": "error",
    "typescript/ban-ts-comment": ["error", { "minimumDescriptionLength": 10 }],
    "typescript/no-explicit-any": "error",
    // Lost promises are the highest-value linted bug class in an agent bridge, as in DSH.
    "typescript/no-floating-promises": ["error", { "allowForKnownSafeCalls": [{ "from": "package", "package": "node:test", "name": ["test", "it", "describe", "suite", "before", "after", "beforeEach", "afterEach"] }] }],
    "typescript/no-misused-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/only-throw-error": "error",
    "typescript/require-await": "error",
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    "no-void": "off" // void foo() marks a deliberate fire-and-forget call.
  },
  "overrides": [
    {
      // As in DSH: test doubles keep async signatures without awaiting, and tests may throw non-Errors on purpose.
      "files": ["**/*.test.*", "tests/**"],
      "rules": { "typescript/require-await": "off", "typescript/only-throw-error": "off" }
    }
  ]
}
