const { chooseOption, controlValue } = require("./controls.cts");
const {test}=require('node:test');const assert: typeof import('node:assert/strict')=require('node:assert/strict');const fs=require('node:fs/promises');const path=require('node:path');const http: typeof import('node:http')=require('node:http');const {chromium}=require(process.env.ELPIS_PLAYWRIGHT_PACKAGE||'playwright');
test('alternate configured provider requires explicit model and native thread keeps it on later sends',async()=>{
 const calls: {method: string | undefined; path: string; data: unknown}[]=[],clients=new Set<import('node:http').ServerResponse>();const thread={id:'local-thread',name:'Local conversation',modelProvider:'local',model:'local/custom-model',status:{type:'idle'},desktopAccess:{writable:true,reason:null}};
 const server=http.createServer((req, res) => { void (async () => {assert.ok(req.url);const url=new URL(req.url,'http://local');let body='';for await(const chunk of req)body+=chunk;const data=body?JSON.parse(body):undefined;calls.push({method:req.method,path:url.pathname,data});const json=(value: unknown)=>{res.setHeader('content-type','application/json');res.end(JSON.stringify(value));};if(url.pathname==='/api/events'){res.writeHead(200,{'content-type':'text/event-stream'});res.write('event: connection\ndata: {"connected":true}\n\n');clients.add(res);return;}if(url.pathname==='/api/health')return json({connected:true});
 // Matilda's companion and setting load on every window (e83d4af2d); answer as the bridge does when she is not pinned.
 if(url.pathname==='/api/love-spot/companion')return json({pinned:false,favorite:null,music:null,reason:''});if(url.pathname==='/api/love-spot/matilda')return json({replies:true,model:null,provider:null});if(url.pathname==='/api/settings')return json({background:{},smartPrune:{explicitOverride:{}},memory:{},write:{available:false},main:{provider:'openai',model:'gpt-6-luna'},providers:[{id:'openai',displayName:'OpenAI'},{id:'local',displayName:'Local endpoint'}],managed:{modelProvider:null}});if(url.pathname==='/api/models')return json({data:url.searchParams.get('provider')==='local'?[]:[{id:'luna',model:'gpt-6-luna',displayName:'Luna 6'}]});if(url.pathname==='/api/threads')return json(req.method==='POST'?{thread}:{data:[],nextCursor:null});if(url.pathname==='/api/threads/local-thread/turns'){json({turn:{id:'turn-'+calls.length}});const turnId='turn-'+calls.length;setTimeout(()=>{for(const client of clients)client.write(`event: message\ndata: ${JSON.stringify({method:'turn/completed',params:{threadId:thread.id,turn:{id:turnId,status:'completed'}}})}\n\n`);},50);return;}try{const file=path.join(__dirname,'../out',url.pathname==='/'?'index.html':url.pathname);res.setHeader('content-type',file.endsWith('.js')?'text/javascript':file.endsWith('.css')?'text/css':'text/html');res.end(await fs.readFile(file));}catch{res.statusCode=404;res.end();}})().catch(error => { res.destroy(error); }); });
 await new Promise<void>(resolve=>server.listen(0,'127.0.0.1',resolve));const address=server.address();assert.ok(address&&typeof address!=='string');const browser=await chromium.launch({executablePath:process.env.ELPIS_CHROMIUM||undefined,headless:true});try{const page=await browser.newPage();page.setDefaultTimeout(7000);await page.goto(`http://127.0.0.1:${address.port}`);await page.getByLabel('Model',{exact:true}).click();await page.getByText('Advanced: use an unlisted model',{exact:true}).click();await chooseOption(page.getByLabel('Provider',{exact:true}), 'local');assert.equal(await page.getByRole('button',{name:'Use model',exact:true}).isDisabled(),true);await page.getByLabel('Model ID',{exact:true}).fill('local/custom-model');await page.getByRole('button',{name:'Use model',exact:true}).click();await page.getByLabel('Message Elpis').fill('Use local provider');await page.getByRole('button',{name:'Send message',exact:true}).click();await page.waitForFunction(()=>(document.querySelector('textarea') as HTMLTextAreaElement).value==='');const created=calls.find(c=>c.path==='/api/threads'&&c.method==='POST');assert.ok(created);assert.deepEqual(created.data,{model:'local/custom-model',provider:'local'});const first=calls.find(c=>c.path.endsWith('/turns'));assert.ok(first);assert.deepEqual(first.data,{text:'Use local provider'});await page.getByRole('button',{name:'Send message',exact:true}).waitFor();assert.equal(await controlValue(page.getByLabel('Model',{exact:true})),'local/custom-model');await page.getByLabel('Message Elpis').fill('Keep the same model');await page.getByRole('button',{name:'Send message',exact:true}).click();await page.waitForFunction(()=>(document.querySelector('textarea') as HTMLTextAreaElement).value==='');const last=calls.filter(c=>c.path.endsWith('/turns')).at(-1);assert.ok(last);assert.deepEqual(last.data,{text:'Keep the same model'});
 }finally{await browser.close();for(const client of clients)client.end();await new Promise(resolve=>server.close(resolve));}
});
