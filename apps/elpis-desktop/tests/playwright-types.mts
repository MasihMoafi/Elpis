// The small portion of the optional Playwright API used by the packaged-app fixtures.
export type Locator = {
  locator(selector: string): Locator;
  getByRole(role: string, options?: object): Locator;
  getByLabel(label: string, options?: object): Locator;
  getByText(text: string | RegExp, options?: object): Locator;
  filter(options: object): Locator;
  first(): Locator;
  last(): Locator;
  all(): Promise<Locator[]>;
  click(options?: object): Promise<void>;
  hover(): Promise<void>;
  focus(): Promise<void>;
  fill(value: string): Promise<void>;
  inputValue(): Promise<string>;
  press(key: string): Promise<void>;
  pressSequentially(text: string): Promise<void>;
  waitFor(options?: object): Promise<void>;
  count(): Promise<number>;
  isDisabled(): Promise<boolean>;
  isEnabled(): Promise<boolean>;
  isVisible(): Promise<boolean>;
  scrollIntoViewIfNeeded(): Promise<void>;
  getAttribute(name: string): Promise<string | null>;
  elementHandle(): Promise<HTMLElement>;
  allInnerTexts(): Promise<string[]>;
  allTextContents(): Promise<string[]>;
  innerText(): Promise<string>;
  boundingBox(): Promise<{ x: number; y: number; width: number; height: number } | null>;
  evaluate<T>(fn: (element: HTMLElement) => T): Promise<T>;
  evaluate<T, A>(fn: (element: HTMLElement, arg: A) => T, arg: A): Promise<T>;
  evaluateAll<T>(fn: (elements: HTMLElement[]) => T): Promise<T>;
};
export type Page = {
  close(): Promise<void>;
  isClosed(): boolean;
  bringToFront(): Promise<void>;
  waitForEvent(name: string): Promise<void>;
  frameLocator(selector: string): { locator(selector: string): Locator; getByRole(role: string, options?: object): Locator };
  emulateMedia(options: { colorScheme: string }): Promise<void>;
  url(): string;
  goto(url: string): Promise<void>;
  on(event: 'pageerror', callback: (error: Error) => void): void;
  on(event: 'request', callback: (request: { method(): string; url(): string }) => void): void;
  context(): Context;
  addInitScript(fn: () => unknown): Promise<void>;
  locator(selector: string): Locator;
  getByRole(role: string, options?: object): Locator;
  getByLabel(label: string, options?: object): Locator;
  getByText(text: string | RegExp, options?: object): Locator;
  setDefaultTimeout(ms: number): void;
  setViewportSize(size: { width: number; height: number }): Promise<void>;
  screenshot(options: object): Promise<void>;
  route(pattern: string, handler: (route: { fulfill(options: object): Promise<void>; fallback(): Promise<void>; continue(): Promise<void>; request(): { method(): string; postDataJSON(): { model?: string } } }) => Promise<void>): Promise<void>;
  unroute(pattern: string): Promise<void>;
  reload(): Promise<void>;
  waitForTimeout(ms: number): Promise<void>;
  waitForFunction(fn: () => unknown): Promise<unknown>;
  waitForFunction<T>(fn: (arg: T) => unknown, arg: T): Promise<unknown>;
  evaluate<T>(fn: () => T): Promise<Awaited<T>>;
  evaluate<T, A>(fn: (arg: A) => T, arg: A): Promise<Awaited<T>>;
  waitForRequest(predicate: (request: { url(): string }) => boolean): Promise<unknown>;
  waitForResponse(predicate: (response: { url(): string; request(): { method(): string } }) => boolean): Promise<{ status(): number; text(): Promise<string>; finished(): Promise<void> }>;
  keyboard: { press(key: string): Promise<void>; type(text: string, options?: object): Promise<void> };
  mouse: { move(x: number, y: number): Promise<void>; click(x: number, y: number): Promise<void>; wheel(x: number, y: number): Promise<void> };
};
export type Context = { pages(): Page[]; newPage(): Promise<Page>; addInitScript(fn: () => unknown): Promise<void>; close(): Promise<void> };
export type Browser = { contexts(): Context[]; newContext(options: object): Promise<Context>; close(): Promise<void> };
