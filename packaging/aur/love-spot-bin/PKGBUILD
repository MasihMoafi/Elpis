# Maintainer: Masih Moafi <MasihMoafi at users dot noreply dot github dot com>
pkgname=love-spot-bin
pkgver=0.5.1
pkgrel=1
pkgdesc='Love Spot drawing board (Excalidraw + Matilda + 12 theme characters + multi-provider AI logins)'
arch=('x86_64')
url='https://github.com/MasihMoafi/Elpis'
license=('Apache-2.0' 'MIT')
depends=('glibc' 'gcc-libs' 'openssl' 'gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libsecret' 'mesa' 'xdg-utils')
optdepends=('nodejs: run the provider bridge on the system Node.js 22+ instead of Electron'
            'claude-code: Claude models through your own Claude Code install')
provides=('love-spot')
conflicts=('love-spot' 'elpis-desktop')
options=('!strip' '!debug')
_rel="https://github.com/MasihMoafi/Elpis/releases/download/v${pkgver}"
source=("${_rel}/love-spot_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/MasihMoafi/Elpis/v${pkgver}/LICENSE")
noextract=("love-spot_${pkgver}_amd64.deb")
sha256sums=('4313d1c2465bf3f6c934e73ef8c47e97d406b8e2f474755d3eeb26fd9b347426'
            'SKIP')

package() {
  bsdtar -xOf "love-spot_${pkgver}_amd64.deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  chmod 4755 "$pkgdir/opt/love-spot/runtime/electron/chrome-sandbox"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgdir/usr/share/doc/love-spot/THIRD-PARTY-NOTICES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}
