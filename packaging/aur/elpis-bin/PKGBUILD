# Maintainer: Masih Moafi <MasihMoafi at users dot noreply dot github dot com>
pkgname=elpis-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='Coding agents you can see, check and combine: terminal and desktop app'
arch=('x86_64')
url='https://github.com/MasihMoafi/Elpis'
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'openssl' 'gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libsecret' 'mesa' 'xdg-utils')
optdepends=('nodejs: run the provider bridge on the system Node.js 22+ instead of Electron'
            'claude-code: Claude models through your own Claude Code install')
provides=('elpis')
conflicts=('elpis')
options=('!strip' '!debug')
_rel="https://github.com/MasihMoafi/Elpis/releases/download/v${pkgver}"
source=("${_rel}/elpis_${pkgver}_amd64.deb"
        "${_rel}/elpis-desktop_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/MasihMoafi/Elpis/v${pkgver}/LICENSE")
noextract=("elpis_${pkgver}_amd64.deb" "elpis-desktop_${pkgver}_amd64.deb")
sha256sums=('aaf630f85397119b7632f1201a228ed1f43fb49344dedb0a11efbb34c980d5d7'
            '9aee50c454c68374f198da396e2108dd39fcb2975a1f8086cea66ac22834fe5f'
            'SKIP')

package() {
  local deb
  for deb in "elpis_${pkgver}_amd64.deb" "elpis-desktop_${pkgver}_amd64.deb"; do
    bsdtar -xOf "$deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  done
  # Chromium's sandbox helper must be setuid root when user namespaces are restricted.
  chmod 4755 "$pkgdir/opt/elpis-desktop/runtime/electron/chrome-sandbox"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
