#!/usr/bin/env bash
# Elpis pre-commit (run by the shared hook in ~/Desktop/p/skills/dev/secret-guard/hooks/pre-commit), modelled on DeepSeek
# Harness's lefthook.yml: whitespace errors in the staged changes, then oxlint on the staged desktop JS/TS files against
# the ratchet in apps/elpis-desktop/strict-baseline.json (scripts/strict-baseline.mts). Type checks run before a push.
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"; app="$repo/apps/elpis-desktop"
git diff --cached --check
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- 'apps/elpis-desktop/*.mjs' 'apps/elpis-desktop/*.cjs' \
  'apps/elpis-desktop/*.mts' 'apps/elpis-desktop/*.cts' 'apps/elpis-desktop/*.js' 'apps/elpis-desktop/*.ts' 'apps/elpis-desktop/*.tsx' | sed 's#^apps/elpis-desktop/##')
[ "${#files[@]}" = 0 ] && exit 0
if [ ! -x "$app/node_modules/.bin/oxlint" ]; then
  echo "pre-commit: oxlint is not installed; run: (cd apps/elpis-desktop && npm ci --ignore-scripts)" >&2; exit 1
fi
cd "$app" && PATH="/usr/local/node/bin:$PATH" nice -n 19 node scripts/strict-baseline.mts lint --files "${files[@]}"
