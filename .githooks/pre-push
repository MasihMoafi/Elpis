#!/usr/bin/env bash
# Elpis pre-push (run by the shared hook in ~/Desktop/p/skills/dev/secret-guard/hooks/pre-push): before commits leave
# this computer, every desktop test file they change runs here (apps/elpis-desktop/scripts/changed-tests.mjs).
# 5 Nov, Masih: "add lints to help you catch issues before CI failures". Skip once with ELPIS_SKIP_CHANGED_TESTS=1.
# First the type checks (6 Nov, as in DeepSeek Harness's lefthook pre-push): the renderer must stay clean and the strict
# JS and TSX checks may not exceed apps/elpis-desktop/strict-baseline.json.
set -euo pipefail
app="$(git rev-parse --show-toplevel)/apps/elpis-desktop"
if [ ! -x "$app/node_modules/.bin/tsc" ]; then echo "pre-push: run (cd apps/elpis-desktop && npm ci --ignore-scripts) first" >&2; exit 1; fi
(cd "$app" && PATH="/usr/local/node/bin:$PATH" nice -n 19 node_modules/.bin/tsc --noEmit -p tsconfig.json --incremental false \
  && PATH="/usr/local/node/bin:$PATH" nice -n 19 node scripts/strict-baseline.mjs types tsx) < /dev/null
[ "${ELPIS_SKIP_CHANGED_TESTS:-}" = 1 ] && exit 0
repo="$(git rev-parse --show-toplevel)"; zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base="$remote_sha"; [ "$base" = "$zero" ] && base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-parse "$local_sha~1")"
  git cat-file -e "$base^{commit}" 2>/dev/null || continue
  PATH="/usr/local/node/bin:$PATH" nice -n 19 node "$repo/apps/elpis-desktop/scripts/changed-tests.mjs" "$base"
done
