#!/usr/bin/env bash
# Elpis pre-push (run by the shared hook in ~/Desktop/p/skills/dev/secret-guard/hooks/pre-push, after its secret scan):
# the small unit test files (fast tier) the pushed commits change run here (apps/elpis-desktop/scripts/changed-tests.mts;
# 5 Nov, Masih: "add lints to help you catch issues before CI failures"). Nothing heavy runs on his laptop (Masih: "Please
# don't do builds locally"; its fans): the type checks and the strict baseline run in GitHub's Lint workflow on every
# push, and the bridge, desktop and browser tests in "Elpis desktop" on build/**. Skip once with ELPIS_SKIP_CHANGED_TESTS=1.
set -euo pipefail
[ "${ELPIS_SKIP_CHANGED_TESTS:-}" = 1 ] && exit 0
repo="$(git rev-parse --show-toplevel)"; zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base="$remote_sha"; [ "$base" = "$zero" ] && base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-parse "$local_sha~1")"
  git cat-file -e "$base^{commit}" 2>/dev/null || continue
  PATH="/usr/local/node/bin:$PATH" nice -n 19 node "$repo/apps/elpis-desktop/scripts/changed-tests.mts" "$base"
done
