{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TurnActivityStatus": {
      "enum": [
        "completed",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "TurnProfileSummary": {
      "description": "Scalar timing facts only; no messages, paths, account, provider, or trace data.",
      "properties": {
        "afterLastSamplingMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "beforeFirstSamplingMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "betweenSamplingOverheadMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "compactionMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "samplingMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "samplingRequestCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "samplingRetryCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "toolBlockingMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "afterLastSamplingMs",
        "beforeFirstSamplingMs",
        "betweenSamplingOverheadMs",
        "compactionMs",
        "samplingMs",
        "samplingRequestCount",
        "samplingRetryCount",
        "toolBlockingMs"
      ],
      "type": "object"
    }
  },
  "description": "Ephemeral scalar-only terminal activity; never part of a persisted turn.",
  "properties": {
    "durationMs": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/definitions/TurnProfileSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "$ref": "#/definitions/TurnActivityStatus"
    },
    "threadId": {
      "type": "string"
    },
    "timeToFirstTokenMs": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "threadId",
    "turnId"
  ],
  "title": "TurnActivityUpdatedNotification",
  "type": "object"
}