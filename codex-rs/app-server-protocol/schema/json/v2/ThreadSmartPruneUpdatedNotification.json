{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadSmartPruneAdmissionSnapshot": {
      "properties": {
        "admissionId": {
          "type": "string"
        },
        "admittedOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxAdmittedTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxSavedTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxSourceTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "auditPath": {
          "type": "string"
        },
        "examinedOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "requestInputSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestLinkageVerified": {
          "type": "boolean"
        },
        "requestSequence": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "responseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "responseLinkageVerified": {
          "type": "boolean"
        },
        "responseUsage": {
          "anyOf": [
            {
              "$ref": "#/definitions/TokenUsageBreakdown"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "admissionId",
        "admittedOutputs",
        "approxAdmittedTokens",
        "approxSavedTokens",
        "approxSourceTokens",
        "auditPath",
        "examinedOutputs",
        "requestLinkageVerified",
        "responseLinkageVerified"
      ],
      "type": "object"
    },
    "ThreadSmartPruneAttemptSnapshot": {
      "properties": {
        "admittedOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxSavedTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "attemptId": {
          "type": "string"
        },
        "auditPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidateOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "latencyMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "modelSlug": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/TokenUsageBreakdown"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "admittedOutputs",
        "approxSavedTokens",
        "attemptId",
        "candidateOutputs",
        "latencyMs",
        "modelSlug",
        "reasoningEffort",
        "status"
      ],
      "type": "object"
    },
    "ThreadSmartPruneSnapshot": {
      "properties": {
        "admittedOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxAdmittedTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxSavedTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "approxSourceTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "examinedOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "failedBatches": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "latest": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadSmartPruneAdmissionSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestAttempt": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadSmartPruneAttemptSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "mainRequestSequence": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "optimizerLatencyMs": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "optimizerRequests": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "optimizerUsage": {
          "allOf": [
            {
              "$ref": "#/definitions/TokenUsageBreakdown"
            }
          ],
          "default": {
            "cachedInputTokens": 0,
            "inputTokens": 0,
            "outputTokens": 0,
            "reasoningOutputTokens": 0,
            "totalTokens": 0
          }
        },
        "optimizerUsageReports": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "unchangedOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "admittedOutputs",
        "approxAdmittedTokens",
        "approxSavedTokens",
        "approxSourceTokens",
        "enabled",
        "examinedOutputs",
        "failedBatches",
        "mainRequestSequence",
        "unchangedOutputs"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteTokens": {
          "description": "Input tokens written to the prompt cache by this request.\n\n`None` means the provider did not report the field, which is not the same as a reported zero.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "description": "Thread-scoped Smart Prune state emitted after config refresh or listener attachment.\n\nThis is intentionally separate from token usage because a config change can happen without an active turn or a provider usage sample.",
  "properties": {
    "smartPrune": {
      "$ref": "#/definitions/ThreadSmartPruneSnapshot"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "smartPrune",
    "threadId"
  ],
  "title": "ThreadSmartPruneUpdatedNotification",
  "type": "object"
}