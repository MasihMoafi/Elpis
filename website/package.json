{
  "name": "elpis-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "python3 ../scripts/build-public-content.py && npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.json && tsc -p candidates/persistent-logo/tsconfig.json",
    "build:css": "tailwindcss -i ./source.css -o ./styles.css --minify",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.28",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.3.3"
  }
}
