#!/usr/bin/env bash
# Open a fresh Elpis API-credit session or resume one from this profile.
set -euo pipefail
runtime_dir=$(dirname -- "$(realpath -- "$0")")
export ELPIS_HOME="${ELPIS_CREDITS_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/elpis/openai-api-credits}"
export CODEX_HOME="$ELPIS_HOME"
export ELPIS_OPENAI_CREDITS_ONLY=1
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY FTP_PROXY http_proxy https_proxy all_proxy ftp_proxy NODE_USE_ENV_PROXY
mkdir -p -m 700 -- "$ELPIS_HOME"
export ELPIS_ENGINE_BIN="${ELPIS_CREDITS_ENGINE:-$(command -v elpis-next)}"
socket=$(node "$runtime_dir/shared-runtime.mts" "$runtime_dir/acp-bridge.mts")
case "$socket" in unix:///*) ;; *) echo "The Elpis credit profile could not start its local bridge." >&2; exit 1 ;; esac
exec "$ELPIS_ENGINE_BIN" --elpis-local-bridge --remote "$socket" --model "openai-credits/${ELPIS_CREDITS_MODEL:-gpt-6.2-sol}" "$@"
