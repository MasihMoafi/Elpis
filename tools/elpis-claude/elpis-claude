#!/usr/bin/env bash
# Elpis TUI with Claude (Pro/Max subscription, via ACP) answering the turns.
# Everything else (Context Ledger, settings, account) stays on the Elpis engine.
# One bridge serves every terminal of an ELPIS_HOME and outlives them; shared-runtime.mjs starts it
# if needed and prints its endpoint. A different installed version already serving this home is
# reported, not replaced.
# Usage: elpis-claude [elpis options], e.g. elpis-claude -a on-request
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
mkdir -p /tmp/acp-bridge
endpoint="$(NODE_USE_ENV_PROXY=1 node "$here/shared-runtime.mjs" "$here/acp-bridge.mjs")"
exec "${ELPIS_ENGINE_BIN:-$HOME/.local/bin/elpis}" --remote "$endpoint" "$@"
